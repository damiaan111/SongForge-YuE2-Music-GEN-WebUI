# SongForge configuration.
# Copy to ".env" in the project root and edit. All values are optional; the
# defaults below are what the application uses when the file is absent.

# --- Networking -------------------------------------------------------------
# The backend binds to localhost only. The frontend is what listens on the LAN,
# and it proxies /api to this address. Do not bind the backend to 0.0.0.0 unless
# you have a specific reason.
SONGFORGE_HOST=127.0.0.1
SONGFORGE_PORT=3334

# Origin the frontend is served from. Used for CORS.
SONGFORGE_FRONTEND_ORIGIN=http://localhost:3333

# Extra origins allowed by CORS, comma-separated. Add this PC's LAN address
# here so another device on your network can reach the app, e.g.
#   SONGFORGE_ALLOWED_ORIGINS=http://192.168.1.42:3333
SONGFORGE_ALLOWED_ORIGINS=

# --- Local lyrics model -----------------------------------------------------
# Where the Ollama server listens. Loopback addresses only: this setting is
# process-level precisely so a LAN visitor cannot repoint the backend.
SONGFORGE_OLLAMA_URL=http://127.0.0.1:11434

# --- Storage ----------------------------------------------------------------
# Where projects, models, the database and logs live. Absolute path, or relative
# to the project root. Must be on a drive with room: songs accumulate quickly.
# Defaults to "runtime" beside this file; uncomment to put it elsewhere.
#SONGFORGE_RUNTIME_DIR=/path/to/songforge-runtime

# --- Behaviour --------------------------------------------------------------
# Logging for the app's own loggers: debug, info, warning or error.
SONGFORGE_LOG_LEVEL=info

# --- Frontend ---------------------------------------------------------------
# Set in app/frontend/.env.local, not here. Listed for reference:
#   PORT=3333
#   SONGFORGE_API_URL=http://127.0.0.1:3334
